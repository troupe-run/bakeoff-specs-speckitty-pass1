{"at": "2026-10-02T05:17:04.021421+00:00", "event_id": "01M3XGPT4NDDF8GDXNF3S0N4ZQ", "event_type": "DecisionPointOpened", "payload": {"actor_id": "cli", "actor_type": "human", "decision_point_id": "01M3XGPT4E0D67ZJY8PT7Z9NAT", "input_key": "hand_edit_drift", "mission_id": "01M3XGPG3A3N2MVWSYSTTX1SC9", "mission_slug": "troupe-config-load-show-set-01M3XGPG", "mission_type": "software-dev", "options": ["Files on disk are truth; set diffs against current files; no reconcile events (recommended)", "Projection is truth; show ignores hand edits", "Other"], "origin_flow": "specify", "origin_surface": "planning_interview", "phase": "SPECIFY", "question": "When someone hand-edits the YAML files after the theatre was imported, should show/set treat the files on disk as the source of truth (event store records only commands' changes; no reconcile events), or should the stored projection win?", "recorded_at": "2026-10-02T05:17:04.021421Z", "run_id": "01M3XGPT4E0D67ZJY8PT7Z9NAT", "state_entered_at": "2026-10-02T05:17:04.015005Z", "step_id": "specify.state.hand-edit-drift"}}
{"at": "2026-10-02T05:17:41.932227+00:00", "event_id": "01M3XGQZ5CRXP9V2JXD34VE1G6", "event_type": "DecisionPointResolved", "payload": {"actual_participants": [], "closed_locally_while_widened": false, "closure_message": null, "decision_point_id": "01M3XGPT4E0D67ZJY8PT7Z9NAT", "final_answer": "A: files on disk are the source of truth; show and set always read current files; the stored projection is only the change history; hand edits appear in show but emit no event; a later set records old as the value currently in the file.", "mission_id": "01M3XGPG3A3N2MVWSYSTTX1SC9", "mission_slug": "troupe-config-load-show-set-01M3XGPG", "mission_type": "software-dev", "origin_surface": "planning_interview", "other_answer": false, "rationale": null, "recorded_at": "2026-10-02T05:17:41.932227Z", "resolved_by": "cli", "run_id": "01M3XGPT4E0D67ZJY8PT7Z9NAT", "state_entered_at": "2026-10-02T05:17:41.928389Z", "summary": null, "terminal_outcome": "resolved"}}
