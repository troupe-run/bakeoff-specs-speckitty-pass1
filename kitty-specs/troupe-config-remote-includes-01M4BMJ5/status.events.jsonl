{"aggregate_id": "01M4BMJ55Q91FZYFPD9AG3AEWN", "aggregate_type": "Mission", "event_id": "01M4BMJ58CATZ1GC9XT8SVQ10D", "event_type": "MissionCreated", "payload": {"created_at": "2026-10-07T16:53:47.894831+00:00", "friendly_name": "troupe configuration: remote includes and a schema", "mission_id": "01M4BMJ55Q91FZYFPD9AG3AEWN", "mission_number": null, "mission_slug": "troupe-config-remote-includes-01M4BMJ5", "mission_type": "software-dev", "purpose_context": "Step 7 adds the Remote includes and schema contract section. Teams share configuration by including it from a URL; troupe fetches it on load, refuses to change values that come from it and tells the user which include line to change instead. A JSON Schema in .troupe/troupe.schema.json describes the configuration: the loaded configuration must validate against it, settings marked format uri and values tagged !literal are taken literally rather than as includes, and set writes include-looking strings as literals unless --include is given.", "purpose_tldr": "Configuration can include shared team settings from https:// URLs, read-only to troupe, and a JSON Schema describes the configuration so URL settings are never mistaken for includes.", "target_branch": "feat/troupe-config-remote-includes", "wp_count": 0}, "project_slug": "origin", "project_uuid": "8ca20dbb-06aa-4582-b942-a91ccc6484f9", "schema_version": "5.0.0", "timestamp": "2026-10-07T16:53:47.916262+00:00"}
