{"aggregate_id": "01M3ZT6RJENXK1D5FZYETB4V72", "aggregate_type": "Mission", "event_id": "01M3ZT6RNN7BA8HNT3SRSF898K", "event_type": "MissionCreated", "payload": {"created_at": "2026-10-03T02:41:32.826787+00:00", "friendly_name": "troupe configuration: sync with files", "mission_id": "01M3ZT6RJENXK1D5FZYETB4V72", "mission_number": null, "mission_slug": "troupe-config-sync-files-01M3ZT6R", "mission_type": "software-dev", "purpose_context": "People edit .troupe/ files in their editor while troupe runs. This mission adds 'troupe config watch', which reconciles hand edits into the configuration history as they happen, makes every command except history reconcile first so offline edits are picked up, and ensures troupe's own write-backs are never re-detected as new changes.", "purpose_tldr": "Keep troupe's recorded configuration in step with hand edits to the theatre's files, live and between runs.", "target_branch": "feat/troupe-config-sync-files", "wp_count": 0}, "project_slug": "origin", "project_uuid": "8ca20dbb-06aa-4582-b942-a91ccc6484f9", "schema_version": "5.0.0", "timestamp": "2026-10-03T02:41:32.853605+00:00"}
